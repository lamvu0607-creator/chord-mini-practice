# Local persistence
SQLITE_DATABASE_PATH=./storage/db/chordmini.sqlite
LOCAL_AUDIO_STORAGE_DIR=./storage/audio
LOCAL_AUDIO_QUOTA_GB=20
LOCAL_AUDIO_MAX_UPLOAD_MB=100

# Local queue worker

# Application and backends
NEXT_PUBLIC_BASE_URL=http://localhost:3000
PYTHON_API_URL=http://localhost:5001
LOCAL_SHEETSAGE_API_URL=http://localhost:8082
SHEETSAGE_API_URL=
SHEETSAGE_BACKEND_TIMEOUT_MS=600000
LOCAL_STEMS_API_URL=http://localhost:8083
STEMS_API_URL=
STEMS_BACKEND_TIMEOUT_MS=1800000
STEMS_QUOTA_GB=10

# API keys
NEXT_PUBLIC_YOUTUBE_API_KEY=
MUSIC_AI_API_KEY=
GEMINI_API_KEY=
GENIUS_API_KEY=

# Feature flags
NEXT_PUBLIC_AUDIO_STRATEGY=auto
NEXT_PUBLIC_AUDIO_STORAGE_PROVIDER=local
NEXT_PUBLIC_ENABLE_SERVICE_WORKER=false
NEXT_PUBLIC_ENABLE_TRUE_STREAMING=false
NEXT_DISABLE_DEV_OVERLAY=true
USE_MOCK_MUSIC_AI=false

# Protected maintenance/API access
CRON_SECRET=replace_with_random_secret
