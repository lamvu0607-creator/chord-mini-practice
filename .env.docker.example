NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
# Public URL (SEO/OG metadata only; audio URLs are relative). For Tailscale:
# NEXT_PUBLIC_BASE_URL=https://<machine>.<tailnet>.ts.net
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_YOUTUBE_API_KEY=
# ytdlp = extract on the server (yt-dlp + ffmpeg ship in the frontend image).
# "auto" falls back to in-browser extraction on any non-localhost origin, which fails on many phones.
NEXT_PUBLIC_AUDIO_STRATEGY=ytdlp
NEXT_PUBLIC_AUDIO_STORAGE_PROVIDER=local
LOCAL_AUDIO_STORAGE_DIR=/app/storage/audio
SQLITE_DATABASE_PATH=/app/storage/db/chordmini.sqlite
LOCAL_AUDIO_QUOTA_GB=2
LOCAL_AUDIO_MAX_UPLOAD_MB=50
PYTHON_API_URL=http://backend:8080
NEXT_PUBLIC_PYTHON_API_URL=http://backend:8080
SHEETSAGE_API_URL=http://sheetsage:8082
SHEETSAGE_BACKEND_TIMEOUT_MS=600000
STEMS_API_URL=http://stems:8083
STEMS_BACKEND_TIMEOUT_MS=1800000
STEMS_QUOTA_GB=10
MUSIC_AI_API_KEY=
GEMINI_API_KEY=
GENIUS_API_KEY=
CRON_SECRET=replace_with_random_secret
USE_MOCK_MUSIC_AI=false

# GPU (NVIDIA). Set ENABLE_GPU=false and remove `gpus: all` in docker-compose.yml for CPU-only hosts.
ENABLE_GPU=true
# Build-time (rebuild frontend after changing). Experimental models must be enabled for BTC
# to show on a public (non-localhost) URL. Default chord model: btc-cl | btc-sl | chord-cnn-lstm
# (btc-pl is a legacy id of btc-cl). Default beat model: beat-this | madmom | beat-transformer
NEXT_PUBLIC_ENABLE_EXPERIMENTAL_MODELS=true
NEXT_PUBLIC_DEFAULT_CHORD_MODEL=btc-cl
NEXT_PUBLIC_DEFAULT_BEAT_MODEL=beat-this
# Shown in the selector but disabled ("Not deployed"). Comma-separated.
NEXT_PUBLIC_UNDEPLOYED_CHORD_MODELS=chord-cnn-lstm
# BTC chord smoothing (runtime; restart backend after changing). Higher penalty = fewer, longer
# chords; 0 disables a step (penalty 0 + overlap false + min 0 = raw frame-by-frame output).
BTC_SWITCH_PENALTY=8
BTC_MIN_CHORD_DURATION=0.3
BTC_OVERLAP=true
# Beat-synchronous chord decoding (when beats are sent with the chord request): chord-change
# penalty on ordinary beats / on downbeats, and the bonus for chords in the estimated key (0 = off).
BTC_SWITCH_PENALTY_BEAT=2.5
BTC_SWITCH_PENALTY_DOWNBEAT=1.0
BTC_KEY_PRIOR=0.3
# Beat This! (default beat model): checkpoint, madmom DBN post-processing, half precision.
BEAT_THIS_CHECKPOINT=final0
BEAT_THIS_DBN=false
BEAT_THIS_FP16=false
